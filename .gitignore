# Secrets — never commit
.env
.env.local
.env.*.local

# Keep the template tracked
!.env.example

# Claude local overrides (may contain personal settings)
.claude/settings.local.json

# Dev container config (local/Codespaces only, not used by CI)
.devcontainer/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# Test / lint caches
.pytest_cache/
.ruff_cache/

# Local fallback log for failed Supabase analytics writes
/data/failed_query_log.jsonl
