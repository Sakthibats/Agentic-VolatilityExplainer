FRED_API_KEY=
FINNHUB_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ANTHROPIC_API_KEY=

# Optional — usage analytics logging (apps/streamlit_app.py). Leave blank to disable;
# logging is a silent no-op without these. Use the service_role key (server-side only,
# never expose it to a browser) since Streamlit runs server-side.
SUPABASE_URL=
SUPABASE_KEY=

# Optional — Redis cache for investigation tool data (ticker-scoped, 15-min TTL).
# Leave blank to disable; the app runs uncached without it.
REDIS_URL=
REDIS_CACHE_TTL_SECONDS=900