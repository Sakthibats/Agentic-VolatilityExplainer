# Copy to .env (resolved from the repo root regardless of CWD — see backend config.py).
# Leave a setting commented out to use its default: an uncommented blank line sets it to "".
# Everything is optional to BOOT: chart/stats endpoints work with no keys at all via
# yfinance. POST /v1/analyze needs the API key of the vendor that runs it (the web UI's
# model picker defaults to OpenAI).

# LLM vendors — set the key for each vendor you want available in the picker.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Vendor for requests that don't name one, and for the ticker-resolution fallback.
# LLM_PROVIDER=anthropic                 # anthropic | openai
# Models each vendor runs (defaults shown).
# OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=low            # none | low | medium | high
# ANTHROPIC_MODEL=claude-haiku-5-5

# Market data — each falls back to yfinance when blank.
FINNHUB_API_KEY=
FRED_API_KEY=

# Optional — Redis cache for per-tool results and final answers (TTLs in
# clients/redis_cache.py). Blank = no Redis; the per-process memo still applies.
REDIS_URL=

# Optional — usage analytics (analytics/supabase_logger.py). Blank = logging is a no-op.
# This is the service_role key: server-side only, never expose it to a browser.
SUPABASE_URL=
SUPABASE_KEY=

# Debug and logging switches. These are read from the shell environment, NOT from this
# file: set them on the command line, e.g.  LOG_FORMAT=json uvicorn ...
# On Cloud Run, set them as service variables (none are needed in production).
#   LOG_FORMAT=json            json | text (default: JSON on Cloud Run, text elsewhere)
#   LOG_LEVEL=INFO             DEBUG | INFO | WARNING
#   VOLX_LOG_LLM_PAYLOAD=1     per-turn payload sizes + full prompt dumps (local only:
#                              includes users' questions)
#   VOLX_SAVE_RUNS=runs.jsonl  append each finished run to a file for
#                              scripts/quality_report.py (local only)
